# Kopie als .env anlegen und beide Werte ersetzen.
# Zufallswerte erzeugen, z. B.:
#   openssl rand -base64 32
#   powershell -c "[guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N')"

# Gemeinsames Token aller Panels (mindestens 16 Zeichen).
PANEL_TOKEN=bitte-ersetzen-mindestens-16-zeichen

# Kennwort der Weboberflaeche (mindestens 8 Zeichen).
ADMIN_PASSWORD=bitte-ersetzen

# 1 setzen, wenn ein Reverse-Proxy mit HTTPS davor steht. Dann wird das
# Sitzungs-Cookie als Secure markiert und die Client-Adresse aus
# X-Forwarded-For gelesen.
TRUST_PROXY=0

# Auf welcher Adresse und welchem Port der Container erreichbar ist.
# Standard ist nur lokal - fuer den Zugriff aus dem Netz einen Reverse-Proxy
# mit HTTPS davorsetzen.
BIND_ADDRESS=127.0.0.1
HOST_PORT=8080
